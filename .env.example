# URL encoded in the QR code — use your leader sign-up form (e.g. Google Form, Microsoft Form).
QR_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# Optional: milliseconds per slide (default 10000)
# SLIDE_INTERVAL_MS=10000

# Optional: modal heading and last-slide caption
# QR_MODAL_TITLE=Leader interest form
# QR_SLIDE_CAPTION=Scan to open the leader form
